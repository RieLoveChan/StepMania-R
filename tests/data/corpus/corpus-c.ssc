// Corpus file for tests/test_NotesLoaderCorpus.cpp -- do not tidy.
// SSC with split (chart-level) timing: the #NOTEDATA block carries its
// own #BPMS (180) that differs from the song #BPMS (120). #VERSION must
// be >= 0.70 for SetStepsBPMs to honour chart timing.
#VERSION:0.83;
#TITLE:Corpus C;
#SUBTITLE:ssc split timing;
#ARTIST:Tester;
#OFFSET:0.000000;
#BPMS:0.000=120.000;
#NOTEDATA:;
#STEPSTYPE:dance-single;
#DESCRIPTION:Corpus C Medium;
#DIFFICULTY:Medium;
#METER:5;
#BPMS:0.000=180.000;
#NOTES:
0000
1000
0100
0010
;
