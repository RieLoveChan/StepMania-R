// Characterization corpus file for tests/test_NotesLoaderFull.cpp.
// Song-level tags only -- no #NOTEDATA block, so SSCLoader stays in its
// GETTING_SONG_INFO state and never needs GAMEMAN. Hand-authored; keep
// the values in sync with the test's expectations. Do not "tidy".
#VERSION:0.83;
#TITLE:Characterization Basic SSC;
#SUBTITLE:SSC Subtitle;
#ARTIST:SSC Artist;
#GENRE:Test;
#CREDIT:test-suite;
#OFFSET:-0.250000;
#SAMPLESTART:9.000;
#SAMPLELENGTH:20.000;
#SELECTABLE:YES;
#BPMS:0.000=100.000,16.000=200.000;
#STOPS:8.000=0.500;
